# ==============================================================================
# SIH26188 - AI-Based Fake Identity & Document Screening System Backend
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env or inject these variables into your container environment.
# NEVER commit production secrets or real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL managed by Database Lead)
# In dev profile, will fallback to in-memory H2 if DB is not reachable
DB_URL=jdbc:postgresql://localhost:5432/idshield_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
JPA_HIBERNATE_DDL_AUTO=update

# JWT Security Secrets (Must be at least 256 bits / 32 bytes base64 or secure hex)
# Example generated with `openssl rand -base64 64`
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000          # 15 minutes (15 * 60 * 1000)
JWT_REFRESH_EXPIRATION_MS=604800000      # 7 days (7 * 24 * 60 * 60 * 1000)

# Internal AI Service Configuration (FastAPI Service managed by AI Lead)
# The frontend NEVER calls this. Only Spring Boot backend communicates internally.
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=30000
AI_MOCK_FALLBACK_ENABLED=true            # Set to true for local testing if AI team service is offline

# CORS Configuration (Explicit allowed origins - NEVER wildcard * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Document Storage & Upload Policy
STORAGE_UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB

# Rate Limiting Configuration (In-Memory Prototype)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

